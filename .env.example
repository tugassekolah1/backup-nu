# ---------------------------------------------------------------------------
# Template konfigurasi environment — SI NU Banjaranyar
#
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya:
#     cp .env.example .env
#     php artisan key:generate
#
# Nilai di bawah adalah default untuk pengembangan lokal.
# Lihat bagian "Checklist Deploy Produksi" di README.md untuk nilai produksi.
# ---------------------------------------------------------------------------

APP_NAME="NU Banjaranyar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Untuk produksi gunakan:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://domain-anda.sch.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Untuk produksi: LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# Default pengembangan memakai SQLite (berkas database/database.sqlite).
# Untuk produksi sangat disarankan MySQL/MariaDB atau PostgreSQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nu_banjaranyar
# DB_USERNAME=nu
# DB_PASSWORD=

# --- Sesi -------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Untuk produksi (HTTPS) tambahkan:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ------------------------------------------------------------------
# `log` hanya menulis email ke storage/logs. Untuk produksi gunakan SMTP:
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Awan (opsional) --------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Data awal (seeder) -----------------------------------------------------
# Dipakai `php artisan db:seed`. Bila dikosongkan, password admin dibuat acak
# dan dicetak ke terminal sekali saat seeding.
SEEDER_ADMIN_EMAIL=admin@gmail.com
SEEDER_ADMIN_PASSWORD=
