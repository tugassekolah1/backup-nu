# ---------- Tahap 1: build aset Vite ----------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---------- Tahap 2: aplikasi Laravel ----------
FROM dunglas/frankenphp:1-php8.4

WORKDIR /app

# Extension untuk PostgreSQL (Neon), gambar/QR (gd), dan kebutuhan Laravel umum
RUN install-php-extensions pdo_pgsql pgsql bcmath intl zip opcache gd

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install dependency dulu supaya cache layer Docker terpakai
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY . .

# Salin hasil build Vite dari tahap 1
COPY --from=assets /app/public/build ./public/build

RUN composer dump-autoload --optimize --no-dev \
    && php artisan event:cache \
    && php artisan view:cache \
    && mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

CMD ["frankenphp", "run", "--config", "/app/Caddyfile"]